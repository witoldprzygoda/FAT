# debug information files
*.dwo

ana
*.pcm
*.root
MyDict.cc

# Plot outputs — keep the directory (via .gitkeep) but ignore generated images
plots/output/*
!plots/output/.gitkeep

# research/ artefacts: standalone binary + generated outputs/plots.
# Per-channel and result ROOTs land directly in research/ (covered by the
# global *.root rule above). Keep .gitkeep so the plots dir survives a clone.
research/meson_research
research/plots/output/*
!research/plots/output/.gitkeep

# research/calibration/ — calibration macros that read output_*_cal.root
# produced by ./ana in trigger_calibration mode. The pre-cal-mode raw-data
# scanner was moved to legacy_raw_scan/ for reference; its binary lives
# there too and is gitignored.
research/calibration/legacy_raw_scan/trigger_scan
research/calibration/plots/output/*
!research/calibration/plots/output/.gitkeep

# Calibration tables — produced by trigger_calibration.C and consumed by the
# main analysis on pp45_epem. Live in repo root because the main analysis
# expects them next to its configs; gitignored because they are derived
# artefacts, not source. (ROOT TTree, not JSON — granularity is intra-file
# event ranges, see research/calibration/plots/trigger_calibration.C.)
pt3_calibration_*.root
